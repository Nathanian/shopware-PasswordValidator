{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_content %}
    <style>
        .umi-page {
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, #ffb3ec 0%, transparent 30%),
                radial-gradient(circle at top right, #b3f0ff 0%, transparent 35%),
                linear-gradient(135deg, #1f1147 0%, #3f1d7a 45%, #6d28d9 100%);
            color: white;
            padding: 60px 20px;
            font-family: Arial, sans-serif;
        }

        .umi-container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .umi-hero {
            text-align: center;
            padding: 60px 20px 40px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 28px;
            backdrop-filter: blur(10px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.25);
        }

        .umi-badge {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 999px;
            background: #ffd166;
            color: #2d1b00;
            font-weight: bold;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .umi-title {
            font-size: 56px;
            line-height: 1.1;
            margin-bottom: 20px;
            font-weight: 800;
        }

        .umi-title span {
            color: #ffd166;
            text-shadow: 0 0 20px rgba(255, 209, 102, 0.4);
        }

        .umi-text {
            font-size: 20px;
            max-width: 750px;
            margin: 0 auto 30px;
            color: rgba(255,255,255,0.9);
        }

        .umi-buttons {
            display: flex;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .umi-btn {
            display: inline-block;
            padding: 14px 26px;
            border-radius: 14px;
            text-decoration: none;
            font-weight: bold;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .umi-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
        }

        .umi-btn-primary {
            background: #ffd166;
            color: #2a1900;
        }

        .umi-btn-secondary {
            background: rgba(255,255,255,0.15);
            color: white;
            border: 1px solid rgba(255,255,255,0.2);
        }

        .umi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-top: 40px;
        }

        .umi-card {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 22px;
            padding: 24px;
            box-shadow: 0 12px 30px rgba(0,0,0,0.18);
        }

        .umi-card h3 {
            font-size: 22px;
            margin-bottom: 10px;
        }

        .umi-card p {
            margin: 0;
            color: rgba(255,255,255,0.88);
            line-height: 1.5;
        }

        .umi-funbox {
            margin-top: 40px;
            padding: 28px;
            border-radius: 24px;
            background: linear-gradient(135deg, rgba(255,209,102,0.18), rgba(255,255,255,0.08));
            border: 1px solid rgba(255,255,255,0.18);
            text-align: center;
        }

        .umi-funbox strong {
            color: #ffd166;
        }

        .umi-footer-note {
            text-align: center;
            margin-top: 30px;
            color: rgba(255,255,255,0.7);
            font-size: 14px;
        }
    </style>

    <div class="umi-page">
        <div class="umi-container">
            <div class="umi-hero">
                <div class="umi-badge">🚀 Erste Shopware Testseite</div>

                <h1 class="umi-title">
                    Willkommen auf meiner <span>super wilden Plugin-Testseite</span>
                </h1>

                <p class="umi-text">
                    {{ example }}<br><br>
                   yolo
                </p>

                <div class="umi-buttons">
                    <a href="#" class="umi-btn umi-btn-primary">🛒 Absolut unnötig klicken</a>
                    <a href="#" class="umi-btn umi-btn-secondary">⚙️ Ich teste nur Shopware</a>
                </div>
            </div>

            <div class="umi-grid">
                <div class="umi-card">
                    <h3>🔥 Plugin Power</h3>
                    <p>
                        Hier kannst du später eigene Shopware-Funktionen einbauen, statt nur langweilige Standardseiten zu zeigen.
                    </p>
                </div>

                <div class="umi-card">
                    <h3>🎨 Fancy Design</h3>
                    <p>
                        Auch ohne großes HTML-Wissen kannst du mit etwas Twig und CSS schon ziemlich coole Seiten bauen.
                    </p>
                </div>

                <div class="umi-card">
                    <h3>🧠 Lernmodus aktiviert</h3>
                    <p>
                        Diese Seite ist dein Spielplatz. Perfekt, um Blöcke, Variablen und Layouts in Shopware zu verstehen.
                    </p>
                </div>
            </div>

            <div class="umi-funbox">
                <h2>😄 Wichtige Durchsage</h2>
                <p>
                    Falls hier noch nicht alles perfekt ist: kein Problem.<br>
                    Jeder große Entwickler hat mal mit einer wilden Testseite angefangen.<br><br>
                    <strong>Nächste Mission:</strong> eigene Inhalte, echte Buttons, eigene Styles und später dein erstes richtiges Plugin-Feature.
                </p>
            </div>

            <div class="umi-footer-note">
                Erstellt mit Neugier, Docker, Shopware und einer kleinen Portion Chaos.
            </div>
        </div>
    </div>
{% endblock %}