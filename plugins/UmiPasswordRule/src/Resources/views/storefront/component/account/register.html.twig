{% sw_extends '@Storefront/storefront/component/account/register.html.twig' %}

{% block component_account_register_personal_password_input %}
    {% set passwordFieldDescription = 'umiPasswordRule.password.description'|trans|sw_sanitize %}

    {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
        type: 'password',
        label: 'account.personalPasswordLabel'|trans|sw_sanitize,
        id: 'personalPassword',
        name: 'password',
        autocomplete: 'new-password',
        description: passwordFieldDescription,
        violationPath: '/password',
        validationRules: 'required,pattern',
        required: true,
        attributes: {
            'data-umi-register-password': 'true',
            pattern: '^(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])(?=.*[^A-Za-z0-9]).{10,}$',
            'data-form-validation-pattern-message': 'umiPasswordRule.password.patternMessage'|trans|sw_sanitize,
            'data-password-message-too-short': 'umiPasswordRule.password.rule.tooShort'|trans|sw_sanitize,
            'data-password-message-missing-uppercase': 'umiPasswordRule.password.rule.missingUppercase'|trans|sw_sanitize,
            'data-password-message-missing-lowercase': 'umiPasswordRule.password.rule.missingLowercase'|trans|sw_sanitize,
            'data-password-message-missing-number': 'umiPasswordRule.password.rule.missingNumber'|trans|sw_sanitize,
            'data-password-message-missing-special-character': 'umiPasswordRule.password.rule.missingSpecialCharacter'|trans|sw_sanitize
        }
    } %}
{% endblock %}
